      "source": "#\n#PART 6: VISUALIZATIONS\n#\n\nprint(\"=\" * 60)\nprint(\"GENERATING VISUALIZATIONS\")\nprint(\"=\" * 60)\nprint()\n\n#Create figure with multiple subplots\nfig = plt.figure(figsize=(16, 12))\n\n#Chart 1: Satisfaction Distribution\nax1 = plt.subplot(2, 3, 1)\nsatisfaction_counts.plot(kind='bar', ax=ax1, color='skyblue', edgecolor='black')\nax1.set_title('Satisfaction Score Distribution', fontsize=12, fontweight='bold')\nax1.set_xlabel('Satisfaction Score')\nax1.set_ylabel('Number of Employees')\nax1.set_xticklabels(ax1.get_xticklabels(), rotation=0)\n\n#Chart 2: Average Satisfaction by Department\nax2 = plt.subplot(2, 3, 2)\ndept_satisfaction = df.groupby('department')['satisfaction'].mean().sort_values()\ncolors = ['red' if x < 3.5 else 'green' for x in dept_satisfaction]\ndept_satisfaction.plot(kind='barh', ax=ax2, color=colors, edgecolor='black')\nax2.set_title('Average Satisfaction by Department', fontsize=12, fontweight='bold')\nax2.set_xlabel('Satisfaction Score')\nax2.axvline (x=3.5, color='orange', linestyle='--', linewidth=2, label='Target: 3.5')\nax2.legend()\n\n#Chart 3: Salary vs Satifaction\nax3 = plt.subplot(2, 3, 3)\ndepartments = df['department'].unique()\ncolors_map = {'HR': 'blue', 'Engineering': 'red', 'Marketing': 'green', 'Sales': 'orange'}\nfor dept in departments:\n    dept_data = df[df['department'] == dept]\n    ax3.scatter(dept_data['salary'], dept_data['satisfaction'],\n                label=dept, alpha=0.6, s=100, color=colors_map.get(dept, 'gray'))\nax3.set_title('Salary vs Satisfaction', fontsize=12, fontweight='bold')\nax3.set_xlabel('Salary ($)')\nax3.set_ylabel('Satisfaction Score')\nax3.legend()\nax3.grid(True, alpha=0.3)\n\n# Chart 4: Department Size\nax4 = plt.subplot(2, 3, 4)\ndept_sizes = df['department'].value_counts()\nax4.pie(dept_sizes, labels=dept_sizes.index, autopct='%1.1f%%', startangle=90)\nax4.set_title('Employee Distribution by Department', fontsize=12, fontweight='bold')\n\n#Chart 5: Performance vs